# docker-compose가 참조하는 값들. 이 파일을 .env로 복사해 필요한 값만 덮어쓴다.
# 컨테이너끼리의 연결(호스트명 postgres/chroma/fastapi/spring)은 compose가 자동으로 처리하므로
# 여기서 따로 지정할 필요가 없다.

# --- 데이터베이스 ---
POSTGRES_DB=battery_risk
POSTGRES_USER=battery_app
POSTGRES_PASSWORD=battery_app_password
POSTGRES_PORT=5432

# --- 호스트에 노출할 포트 (compose) ---
SPRING_PORT=8080
CHROMA_PORT=8001

# --- 인증 ---
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

# --- CORS (프론트를 nginx 프록시로 접속하면 사실상 불필요하지만 직접 접속 대비 유지) ---
# 4173 = Vite preview(프론트 e2e/Playwright), 5173 = Vite dev, 3000 = CRA 기본
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# --- AI / RAG ---
SEVERITY_RULE_VERSION=severity-rule-v1
# 기본값 openai(2026-07-31부터, 팀 전체 OPENAI_API_KEY 공유됨). mock 해싱 임베딩은
# 한국어 질의↔영어 계약서 사이 교차언어 검색을 전혀 못 해 실제 조항을 못 찾는 문제를
# 실증으로 확인했다 — OPENAI_API_KEY 없이 이 기본값 그대로 두면 임베딩 호출이 401로
# 실패하니, 로컬에서 키 없이 돌리려면 아래를 mock으로 바꿀 것.
EMBEDDING_PROVIDER=openai
# text-embedding-3-large 기본 차원은 3072 (3-small은 1536). 모델과 반드시 일치시킬 것.
EMBEDDING_DIMENSION=3072
CHROMA_COLLECTION_PREFIX=contract_documents

# --- OpenAI (임베딩 전용 키) ---
# 아래에 실제 키 입력 (이 파일은 예시용, 실제 키는 .env에만! 절대 커밋 금지)
# text-embedding-3-large 임베딩에 쓴다. EMBEDDING_PROVIDER=mock으로 바꾸면 이 키 없이도 동작.
# EMBEDDING_PROVIDER=openai로 처음 전환하는 경우 기존 mock 청크와 컬렉션이 다르므로
# 계약서 문서 재적재가 필요하다(mock 컬렉션과 openai 컬렉션은 별도로 관리됨).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- 환율 (공개 대시보드 ② 밴드 / 한국수출입은행 현재환율 API) ---
# 발급: https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2&viewtype=C > "인증키 발급신청"
# 일일 1000회 제한. 미설정이면 수집만 건너뛰고 부팅은 정상이다(밴드가 빈 채로 뜬다).
# 주의: 개인정보 보유기간 2년이 지나면 키가 파기된다(재동의 메일 미응답 시 result=3).
KOREAEXIM_API_KEY=
# 자동 갱신(KST): 평일 11:00~12:45 15분 간격 창 폴링(고시가 뜨는 즉시 몇 분 내 반영, 오늘치를
# 잡으면 외부 호출 중단) + 16:00 늦은 공표 fallback. 무료 API라 기본 on. 고시환율은 원천이 영업일
# 1회 공표라 값 자체는 하루 한 번 바뀐다 — 창 폴링은 그 "한 번"을 빨리 잡기 위한 것이다.
EXCHANGE_RATE_SCHEDULER_ENABLED=true
# 밴드에 "노출할" 통화 — 수집 범위가 아니다(수집은 거래 가능한 전 통화를 담는다).
# 적은 순서가 곧 화면 노출 순서이고, 추가하면 이미 쌓인 이력이 그대로 따라온다.
# USD·EUR = 실제 결제통화, 나머지 = 조달국 통화. KRW은 기준통화(항상 1)라 제외.
EXCHANGE_RATE_CURRENCIES=USD,EUR,CNH,CLP,AUD,IDR,CDF,ARS,ZAR,BRL,PHP,JPY,CAD,MYR

# 재정환율 — 수출입은행이 고시하지 않는 조달국 통화를 USD 경유로 계산한다.
#   CLP/KRW = (수출입은행 USD/KRW) / (open.er-api.com USD/CLP)
# 칠레·아르헨티나(리튬), 콩고(코발트), 남아공(망간), 브라질, 필리핀(니켈).
# 인증키는 필요 없지만 두 소스의 시각이 섞여 표시용이다(실측 오차 중앙값 0.14%).
#
# !! 무료 등급 조건: 공개 화면에 "Rates By Exchange Rate API" 링크 표기 필요 (footer)
#    https://www.exchangerate-api.com
EXCHANGE_RATE_CROSS_ENABLED=true
EXCHANGE_RATE_CROSS_CURRENCIES=CLP,ARS,CDF,ZAR,BRL,PHP

# F10 메일 알림(SMTP). 최종 합성 위험도가 CRITICAL이면 즉시, WARNING이면 매일 08:00 다이제스트로
# 발송한다. 전부 비우면(기본) 발송만 비활성되고 부팅은 정상이다.
#  · 실발송: Gmail이면 SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, USERNAME=계정, PASSWORD=앱 비밀번호.
#  · 로컬 검증: MailHog 등을 띄우고 SMTP_HOST=localhost SMTP_PORT=1025 NOTIFICATION_MAIL_FROM=test@local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_MAIL_FROM=
# --- Anthropic (멀티에이전트 브리핑 생성 LLM: claude-sonnet-5) ---
# 없으면 use_llm=true 요청이 실패하고 규칙기반 폴백 브리핑으로 조용히 대체된다.
ANTHROPIC_API_KEY=
# 기본 4096은 extended thinking이 예산을 거의 다 먹어 구조화 출력이 잘리는 것을 실증으로
# 확인했다(2026-07-31) — docker-compose.yml 기본값이 이미 8192로 상향돼 있어 보통은 안
# 건드려도 되지만, 필요하면 여기서 override 가능.
# ANTHROPIC_MAX_TOKENS=8192

# --- ERP 시드 (컨테이너에서는 기본 비활성) ---
ERP_SEED_ENABLED=false

# --- RAG 계약서 시드 (data/RAG_DATA/erp_aligned → ChromaDB, 기본 비활성) ---
# 켜면 시작 시 계약서 파일을 파일명 접두사(CTR-XXX)로 PK 매핑해 자동 적재한다.
# 전제: EMBEDDING_PROVIDER=openai + OPENAI_API_KEY, 그리고 ERP_SEED로 계약 매핑이 먼저 있어야 함.
RAG_SEED_ENABLED=false

# --- 프론트 e2e용 테스트 계정 시드 (운영 비활성, CI/로컬 e2e에서만 true) ---
# 켜면 purchasing/planning/executive@test.local(비번 test1234!, APPROVED)와
# pending@company.com(비번 anything, PENDING)을 users에 upsert 한다.
AUTH_TEST_SEED_ENABLED=false

# --- 로컬(도커 밖)에서 Spring을 직접 실행할 때만 쓰는 값 ---
# POSTGRES_URL=jdbc:postgresql://localhost:5432/battery_risk
# FASTAPI_BASE_URL=http://localhost:8000
